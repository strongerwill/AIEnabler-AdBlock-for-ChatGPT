{
  "manifest_version": 3,
  "name": "AIEnabler - AdBlock for ChatGPT",
  "version": "1.4.1",
  "description": "Hides sponsored ad cards that appear around ChatGPT responses.",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AIEnabler - AdBlock for ChatGPT",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": ["content/hide-ads.css"],
      "js": ["content/hide-ads.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
